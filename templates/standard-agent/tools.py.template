@tool_input_guardrail
def block_sensitive_input(data):
    """Block inputs containing sensitive patterns."""
    sensitive_patterns = ["password", "secret", "api_key", "sk-"]
    input_str = str(data.context.tool_arguments).lower()

    for pattern in sensitive_patterns:
        if pattern in input_str:
            return ToolGuardrailFunctionOutput.reject_content(
                f"Input contains sensitive pattern: {pattern}"
            )
    return ToolGuardrailFunctionOutput.allow()


@tool_output_guardrail
def redact_pii(data):
    """Redact personally identifiable information from output."""
    import re
    output = str(data.output)

    # Redact email addresses
    output = re.sub(r'\b[\w.-]+@[\w.-]+\.\w+\b', '[REDACTED_EMAIL]', output)

    # Redact phone numbers
    output = re.sub(r'\b\d{3}[-.]?\d{3}[-.]?\d{4}\b', '[REDACTED_PHONE]', output)

    if output != str(data.output):
        return ToolGuardrailFunctionOutput.replace_content(output)
    return ToolGuardrailFunctionOutput.allow()
