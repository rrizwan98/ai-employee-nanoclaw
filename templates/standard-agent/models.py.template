class ExtractedEntity(BaseModel):
    """A named entity extracted from text."""
    name: str = Field(description="The entity name")
    type: str = Field(description="Entity type (person, org, location, etc.)")
    confidence: float = Field(default=1.0, ge=0, le=1, description="Confidence score")


class CalendarEvent(BaseModel):
    """A calendar event extracted from text."""
    title: str = Field(description="Event title")
    date: str = Field(description="Event date (YYYY-MM-DD)")
    time: Optional[str] = Field(default=None, description="Event time (HH:MM)")
    duration_minutes: Optional[int] = Field(default=60, description="Duration in minutes")
    location: Optional[str] = Field(default=None, description="Event location")
    participants: List[str] = Field(default_factory=list, description="List of participants")


class SentimentAnalysis(BaseModel):
    """Sentiment analysis result."""
    sentiment: str = Field(description="Overall sentiment: positive, negative, neutral")
    confidence: float = Field(ge=0, le=1, description="Confidence score")
    keywords: List[str] = Field(default_factory=list, description="Key phrases")
    summary: Optional[str] = Field(default=None, description="Brief summary")


class ContactInfo(BaseModel):
    """Extracted contact information."""
    name: Optional[str] = None
    email: Optional[str] = None
    phone: Optional[str] = None
    company: Optional[str] = None
    title: Optional[str] = None
    address: Optional[str] = None


class Invoice(BaseModel):
    """Extracted invoice data."""
    invoice_number: str
    date: str
    due_date: Optional[str] = None
    vendor: str
    total_amount: float
    currency: str = "USD"
    line_items: List[dict] = Field(default_factory=list)


class SupportTicket(BaseModel):
    """Support ticket classification."""
    category: str = Field(description="Ticket category")
    priority: str = Field(description="Priority: low, medium, high, urgent")
    summary: str = Field(description="Brief summary of the issue")
    suggested_department: Optional[str] = None
    sentiment: Optional[str] = None
