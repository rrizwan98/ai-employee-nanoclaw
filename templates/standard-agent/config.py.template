{% if MEMORY.type == "sqlite" %}
# SQLite Configuration
SQLITE_DB_PATH = os.getenv("SQLITE_DB_PATH", "{{MEMORY.config.db_path | default: 'conversations.db'}}")


def get_session(session_id: str) -> SQLiteSession:
    """
    Get or create a SQLite session for conversation memory.

    Args:
        session_id: Unique identifier for the session (e.g., user ID)

    Returns:
        SQLiteSession instance for this user
    """
    return SQLiteSession(
        session_id=session_id,
        db_path=SQLITE_DB_PATH,
    )


async def add_to_history(session_id: str, role: str, content: str):
    """
    Add a message to conversation history.

    Args:
        session_id: Session identifier
        role: "user" or "assistant"
        content: Message content
    """
    session = get_session(session_id)
    await session.add_items([
        {"role": role, "content": content}
    ])


async def get_history(session_id: str) -> list:
    """
    Get conversation history for a session.

    Args:
        session_id: Session identifier

    Returns:
        List of conversation items
    """
    session = get_session(session_id)
    return await session.get_items()


async def clear_history(session_id: str):
    """
    Clear conversation history for a session.

    Args:
        session_id: Session identifier
    """
    session = get_session(session_id)
    await session.clear()
{% endif %}


{% if MEMORY.type == "redis" %}
# Redis Configuration
REDIS_URL = os.getenv("REDIS_URL", "redis://localhost:6379")
REDIS_PASSWORD = os.getenv("REDIS_PASSWORD", None)


def get_session(session_id: str) -> RedisSession:
    """
    Get or create a Redis session for conversation memory.

    Args:
        session_id: Unique identifier for the session (e.g., user ID)

    Returns:
        RedisSession instance for this user
    """
    return RedisSession(
        session_id=session_id,
        redis_url=REDIS_URL,
        password=REDIS_PASSWORD,
        ttl_seconds={{MEMORY.config.ttl | default: 86400}},  # 24 hours default
    )


async def add_to_history(session_id: str, role: str, content: str):
    """
    Add a message to conversation history.

