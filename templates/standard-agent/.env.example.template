# {{AGENT_NAME}} - Environment Variables
# Generated by Agent Builder AI Employee
# Copy this file to .env and fill in your values

# OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-api-key-here

# Agent Configuration
AGENT_NAME={{AGENT_NAME}}
AGENT_PORT={{DEPLOYMENT.port | default: 8000}}

{% if MEMORY.type == "sqlite" %}
# SQLite Memory Configuration
SQLITE_DB_PATH={{MEMORY.config.db_path | default: "conversations.db"}}
{% endif %}

{% if MEMORY.type == "redis" %}
# Redis Memory Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
{% endif %}

{% if TOOLS.file_search %}
# Vector Store for File Search
VECTOR_STORE_ID=vs_your-vector-store-id
{% endif %}

{% if MCP_SERVERS %}
# MCP Server Configuration
{% for server in MCP_SERVERS %}
MCP_SERVER_{{server.name | upper}}_URL={{server.url | default: "http://localhost:3000"}}
{% endfor %}
{% endif %}

# Logging
LOG_LEVEL=INFO

# Development
DEBUG=false
