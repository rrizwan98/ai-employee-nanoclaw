{% if "max_length" in GUARDRAILS.input %}
@InputGuardrail
def validate_max_length(context) -> GuardrailFunctionOutput:
    """
    Reject inputs that are too long.

    Prevents abuse and ensures reasonable processing times.
    """
    max_length = {{GUARDRAILS.max_input_length | default: 10000}}
    if len(context.input) > max_length:
        return GuardrailFunctionOutput.reject_content(
            f"Input too long. Maximum {max_length} characters allowed."
        )
    return GuardrailFunctionOutput.allow()
{% endif %}


{% if "no_injection" in GUARDRAILS.input %}
@InputGuardrail
def block_prompt_injection(context) -> GuardrailFunctionOutput:
    """
    Block common prompt injection attempts.

    Detects patterns that try to override agent instructions.
    """
    injection_patterns = [
        r"ignore (previous|all|above) instructions",
        r"you are now",
        r"system prompt",
        r"jailbreak",
        r"DAN mode",
        r"bypass (safety|restrictions)",
    ]

    input_lower = context.input.lower()
    for pattern in injection_patterns:
        if re.search(pattern, input_lower):
            return GuardrailFunctionOutput.reject_content(
                "Your message contains disallowed content."
            )
    return GuardrailFunctionOutput.allow()
{% endif %}


{% if "no_secrets" in GUARDRAILS.input %}
@InputGuardrail
def block_secrets_in_input(context) -> GuardrailFunctionOutput:
    """
    Warn if input contains potential secrets.

    Prevents accidental exposure of API keys, passwords, etc.
    """
    secret_patterns = [
        r"sk-[a-zA-Z0-9]{20,}",  # OpenAI API key
        r"ghp_[a-zA-Z0-9]{36}",  # GitHub token
        r"password[=:]\s*\S+",   # Password patterns
        r"api[_-]?key[=:]\s*\S+",  # API key patterns
    ]

    for pattern in secret_patterns:
        if re.search(pattern, context.input, re.IGNORECASE):
            return GuardrailFunctionOutput.reject_content(
                "Please remove any API keys, passwords, or secrets from your message."
            )
    return GuardrailFunctionOutput.allow()
{% endif %}


