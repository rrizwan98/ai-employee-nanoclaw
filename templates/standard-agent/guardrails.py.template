{% if "no_pii" in GUARDRAILS.output %}
@OutputGuardrail
def redact_pii(context) -> GuardrailFunctionOutput:
    """
    Redact personally identifiable information from output.

    Protects user privacy by masking sensitive data.
    """
    output = context.output
    modified = False

    # Email addresses
    email_pattern = r'\b[\w.-]+@[\w.-]+\.\w+\b'
    if re.search(email_pattern, output):
        output = re.sub(email_pattern, '[EMAIL REDACTED]', output)
        modified = True

    # Phone numbers (various formats)
    phone_pattern = r'\b(?:\+\d{1,3}[-.\s]?)?\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}\b'
    if re.search(phone_pattern, output):
        output = re.sub(phone_pattern, '[PHONE REDACTED]', output)
        modified = True

    # Social Security Numbers
    ssn_pattern = r'\b\d{3}-\d{2}-\d{4}\b'
    if re.search(ssn_pattern, output):
        output = re.sub(ssn_pattern, '[SSN REDACTED]', output)
        modified = True

    # Credit card numbers
    cc_pattern = r'\b\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}\b'
    if re.search(cc_pattern, output):
        output = re.sub(cc_pattern, '[CARD REDACTED]', output)
        modified = True

    if modified:
        return GuardrailFunctionOutput.replace_content(output)
    return GuardrailFunctionOutput.allow()
{% endif %}


{% if "no_harmful" in GUARDRAILS.output %}
@OutputGuardrail
def filter_harmful_content(context) -> GuardrailFunctionOutput:
    """
    Filter potentially harmful content from output.

    Ensures agent responses are safe and appropriate.
    """
    harmful_patterns = [
        r"how to (make|build|create) (a )?(bomb|weapon|explosive)",
        r"how to (hack|break into)",
        r"how to (harm|hurt|kill)",
    ]

    output_lower = context.output.lower()
    for pattern in harmful_patterns:
        if re.search(pattern, output_lower):
            return GuardrailFunctionOutput.reject_content(
                "I can't help with that request."
            )
    return GuardrailFunctionOutput.allow()
{% endif %}


{% if "max_length" in GUARDRAILS.output %}
@OutputGuardrail
def limit_output_length(context) -> GuardrailFunctionOutput:
    """
    Truncate excessively long outputs.

    Prevents runaway responses and keeps outputs manageable.
    """
    max_length = {{GUARDRAILS.max_output_length | default: 4000}}
    if len(context.output) > max_length:
        truncated = context.output[:max_length] + "\n\n[Response truncated due to length]"
        return GuardrailFunctionOutput.replace_content(truncated)
    return GuardrailFunctionOutput.allow()
{% endif %}


