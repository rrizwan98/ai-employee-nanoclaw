# {{AGENT_NAME}} - Multi-Agent System Docker Configuration
# Generated by Agent Builder AI Employee

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN adduser --disabled-password --gecos "" appuser && \
    chown -R appuser:appuser /app
USER appuser

{% if MEMORY.type == "sqlite" %}
RUN mkdir -p /app/data
VOLUME ["/app/data"]
{% endif %}

EXPOSE {{DEPLOYMENT.port | default: 8000}}

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:{{DEPLOYMENT.port | default: 8000}}/health')" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "{{DEPLOYMENT.port | default: 8000}}"]
