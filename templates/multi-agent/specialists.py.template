"""
{{AGENT_NAME}} - Specialist Agents
Generated by Agent Builder AI Employee

Each specialist handles a specific domain of expertise.
"""

from agents import Agent
{% if TOOLS.custom %}
from tools import {% for tool in TOOLS.custom %}{{tool}}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}


{% for handoff in HANDOFFS %}
# ============================================================
# {{handoff.display_name}}
# ============================================================

{{handoff.name | upper}}_INSTRUCTIONS = """
You are {{handoff.display_name}} for {{AGENT_NAME}}.

Your expertise: {{handoff.description}}

{{handoff.instructions}}

Guidelines:
- Stay within your area of expertise
- If a question is outside your domain, politely explain and offer to transfer
- Be helpful, professional, and thorough
- Ask clarifying questions when needed
"""

{{handoff.name}}_agent = Agent(
    name="{{handoff.display_name}}",
    instructions={{handoff.name | upper}}_INSTRUCTIONS,
    handoff_description="{{handoff.description}}",
{% if handoff.tools %}
    tools=[{% for tool in handoff.tools %}{{tool}}{% if not loop.last %}, {% endif %}{% endfor %}],
{% endif %}
)


{% endfor %}
# ============================================================
# Export all specialists
# ============================================================

specialists = [
{% for handoff in HANDOFFS %}
    {{handoff.name}}_agent,
{% endfor %}
]
