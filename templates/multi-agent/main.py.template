class ChatRequest(BaseModel):
    """Chat request model."""
    message: str
    session_id: str | None = None


class ChatResponse(BaseModel):
    """Chat response model."""
    response: str
    current_agent: str
    session_id: str | None = None


@app.get("/health")
async def health_check():
    """Health check endpoint."""
    return {
        "status": "healthy",
        "agent": "{{AGENT_NAME}}",
        "type": "multi-agent",
    }


@app.get("/agents")
async def list_agents():
    """List available agents in the system."""
    from specialists import specialists
    return {
        "orchestrator": orchestrator.name,
        "specialists": [agent.name for agent in specialists],
    }


@app.post("/chat", response_model=ChatResponse)
async def chat(request: ChatRequest):
    """
    Send a message to the multi-agent system.

    The orchestrator will route to the appropriate specialist.

    Args:
        request: ChatRequest with message and optional session_id

    Returns:
        ChatResponse with agent response and current agent name
    """
    from agents import Runner

    try:
        {% if MEMORY.type != "none" %}
        session = get_session(request.session_id) if request.session_id else None
        result = await Runner.run(orchestrator, request.message, session=session)
        {% else %}
        result = await Runner.run(orchestrator, request.message)
        {% endif %}

        # Determine which agent responded
        current_agent = orchestrator.name
        if hasattr(result, 'agent_name'):
            current_agent = result.agent_name

        return ChatResponse(
            response=result.final_output,
            current_agent=current_agent,
            session_id=request.session_id,
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/chat/stream")
async def chat_stream(request: ChatRequest):
    """
    Stream multi-agent response with handoff notifications.
    """
    from agents import Runner

    async def generate():
        try:
            {% if MEMORY.type != "none" %}
            session = get_session(request.session_id) if request.session_id else None
            async for event in Runner.run_streamed(orchestrator, request.message, session=session):
            {% else %}
            async for event in Runner.run_streamed(orchestrator, request.message):
            {% endif %}
                if hasattr(event, 'content') and event.content:
                    yield event.content
                elif hasattr(event, 'type') and event.type == 'handoff':
                    yield f"\n[Transferring to {event.target_agent}]\n"
        except Exception as e:
            yield f"Error: {str(e)}"

    return StreamingResponse(generate(), media_type="text/event-stream")


