# Example tools for voice agents

@function_tool
def get_current_time() -> str:
    """Get the current date and time. Use when user asks about time."""
    from datetime import datetime
    now = datetime.now()
    return now.strftime("It's %I:%M %p on %A, %B %d, %Y")


@function_tool
def get_weather(city: str) -> str:
    """
    Get weather for a city. Use when user asks about weather.

    Args:
        city: The city name to get weather for

    Returns:
        Weather information as spoken text
    """
    # TODO: Integrate with actual weather API
    return f"The weather in {city} is sunny with a high of 72 degrees Fahrenheit."


@function_tool
async def set_reminder(message: str, minutes: int = 5) -> str:
    """
    Set a reminder. Use when user wants to be reminded of something.

    Args:
        message: What to remind about
        minutes: Minutes from now (default 5)

    Returns:
        Confirmation message
    """
    # TODO: Integrate with actual reminder system
