import os
import asyncio
from dotenv import load_dotenv

from agents.realtime import RealtimeAgent, RealtimeRunner
from agents_config import agent, realtime_config

# Load environment variables
load_dotenv()


async def run_voice_session():
    """
    Run an interactive voice session.

    This is for testing purposes. In production, use the FastAPI
    WebSocket server (server.py) for handling voice connections.
    """
    print(f"🎤 {{AGENT_NAME}} Voice Agent is ready!")
    print("Press Ctrl+C to stop.\n")

    runner = RealtimeRunner(
        starting_agent=agent,
        config=realtime_config,
    )

    session = await runner.run()

    async with session:
        print("📞 Connected to Realtime API")
        print("🔊 Listening for audio input...\n")

        async for event in session:
            if event.type == "transcript":
                print(f"📝 Transcript: {event.text}")
            elif event.type == "audio":
                # In production, send this to audio output device
                print(f"🔈 Audio chunk received: {len(event.audio)} bytes")
            elif event.type == "tool_call":
                print(f"🔧 Tool called: {event.tool_name}")
            elif event.type == "agent_handoff":
                print(f"🔄 Handoff to: {event.target_agent}")
            elif event.type == "error":
                print(f"❌ Error: {event.error}")


async def main():
    """Main entry point."""
    try:
        await run_voice_session()
    except KeyboardInterrupt:
        print("\n\n👋 Goodbye!")
    except Exception as e:
        print(f"\n❌ Error: {e}")
        raise


if __name__ == "__main__":
    asyncio.run(main())
