"""
{{AGENT_NAME}} - Realtime Agent Configuration
Generated by Agent Builder AI Employee
"""

from agents.realtime import RealtimeAgent
{% if TOOLS.custom %}
from tools import {% for tool in TOOLS.custom %}{{tool}}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}
{% if HANDOFFS %}
from agents.realtime import realtime_handoff
{% endif %}


# Voice settings
VOICE_SETTINGS = {
    "voice": "{{REALTIME_CONFIG.voice | default: 'alloy'}}",  # alloy, echo, fable, onyx, nova, shimmer, ash
    "modalities": {{REALTIME_CONFIG.modalities | default: '["audio", "text"]'}},
    "input_audio_format": "{{REALTIME_CONFIG.input_format | default: 'pcm16'}}",
    "output_audio_format": "{{REALTIME_CONFIG.output_format | default: 'pcm16'}}",
    "turn_detection": {
        "type": "{{REALTIME_CONFIG.turn_detection | default: 'semantic_vad'}}",
        "interrupt_response": {{REALTIME_CONFIG.interrupt | default: 'True'}},
    },
}


# Agent instructions
INSTRUCTIONS = """{{INSTRUCTIONS}}

Voice Guidelines:
- Speak naturally and conversationally
- Use short, clear sentences
- Confirm understanding before taking actions
- Provide audio-friendly responses (avoid reading URLs, code, etc.)
"""


# Configure tools
tools = [
{% if TOOLS.custom %}
{% for tool in TOOLS.custom %}
    {{tool}},
{% endfor %}
{% endif %}
]


{% if HANDOFFS %}
# Specialist agents for handoffs
{% for handoff in HANDOFFS %}
{{handoff.name}}_agent = RealtimeAgent(
    name="{{handoff.display_name}}",
    instructions="{{handoff.instructions}}",
{% if handoff.tools %}
    tools=[{% for tool in handoff.tools %}{{tool}}{% if not loop.last %}, {% endif %}{% endfor %}],
{% endif %}
)
{% endfor %}
{% endif %}


# Create the realtime agent
agent = RealtimeAgent(
    name="{{AGENT_NAME}}",
    instructions=INSTRUCTIONS,
    tools=tools,
{% if HANDOFFS %}
    handoffs=[
{% for handoff in HANDOFFS %}
        realtime_handoff(
            {{handoff.name}}_agent,
            tool_description="{{handoff.description}}",
        ),
{% endfor %}
    ],
{% endif %}
)


# Realtime runner configuration
realtime_config = {
    "model_settings": {
        "model_name": "gpt-realtime",
        **VOICE_SETTINGS,
    },
}
