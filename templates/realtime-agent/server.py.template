class ConnectionManager:
    """Manage WebSocket connections."""

    def __init__(self):
        self.active_connections: dict[str, WebSocket] = {}

    async def connect(self, websocket: WebSocket, client_id: str):
        await websocket.accept()
        self.active_connections[client_id] = websocket

    def disconnect(self, client_id: str):
        if client_id in self.active_connections:
            del self.active_connections[client_id]

    async def send_audio(self, client_id: str, audio_data: bytes):
        if client_id in self.active_connections:
            await self.active_connections[client_id].send_bytes(audio_data)

    async def send_json(self, client_id: str, data: dict):
        if client_id in self.active_connections:
            await self.active_connections[client_id].send_json(data)


manager = ConnectionManager()


@app.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    """
    WebSocket endpoint for real-time voice communication.

    Protocol:
    - Send binary data for audio input (PCM16, 24kHz)
    - Receive binary data for audio output (PCM16, 24kHz)
    - Receive JSON for transcripts and events

    JSON Events:
    - {"type": "transcript", "role": "user|assistant", "text": "..."}
    - {"type": "tool_call", "name": "...", "arguments": {...}}
    - {"type": "handoff", "agent": "..."}
    - {"type": "error", "message": "..."}
    """
    # Generate unique client ID
    import uuid
    client_id = str(uuid.uuid4())

    await manager.connect(websocket, client_id)
    print(f"📞 Client connected: {client_id}")

    try:
        # Create runner for this session
        runner = RealtimeRunner(
            starting_agent=agent,
            config=realtime_config,
        )

        session = await runner.run()

        async with session:
            # Send ready event
            await manager.send_json(client_id, {
                "type": "ready",
                "session_id": client_id,
            })

            # Task to receive audio from client
            async def receive_audio():
                try:
                    while True:
                        data = await websocket.receive()
                        if "bytes" in data:
                            # Audio data from client
                            await session.send_audio(data["bytes"])
                        elif "text" in data:
                            # JSON command from client
                            msg = json.loads(data["text"])
                            if msg.get("type") == "end_turn":
                                await session.end_turn()
                except WebSocketDisconnect:
                    pass

            # Task to send events to client
            async def send_events():
                try:
                    async for event in session:
                        if event.type == "audio":
                            await manager.send_audio(client_id, event.audio)
                        elif event.type == "transcript":
                            await manager.send_json(client_id, {
                                "type": "transcript",
                                "role": event.role,
                                "text": event.text,
                            })
                        elif event.type == "tool_call":
                            await manager.send_json(client_id, {
                                "type": "tool_call",
                                "name": event.tool_name,
                                "arguments": event.arguments,
                            })
                        elif event.type == "agent_handoff":
                            await manager.send_json(client_id, {
                                "type": "handoff",
                                "agent": event.target_agent,
                            })
                        elif event.type == "error":
                            await manager.send_json(client_id, {
                                "type": "error",
                                "message": str(event.error),
                            })
                except Exception as e:
                    await manager.send_json(client_id, {
                        "type": "error",
                        "message": str(e),
                    })

            # Run both tasks concurrently
            await asyncio.gather(receive_audio(), send_events())

    except WebSocketDisconnect:
        print(f"📴 Client disconnected: {client_id}")
    except Exception as e:
        print(f"❌ Error with client {client_id}: {e}")
        await manager.send_json(client_id, {
            "type": "error",
            "message": str(e),
        })
    finally:
        manager.disconnect(client_id)


