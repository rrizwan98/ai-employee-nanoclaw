# {{AGENT_NAME}} - Realtime Voice Agent Environment Variables
# Generated by Agent Builder AI Employee
# Copy this file to .env and fill in your values

# OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-api-key-here

# Agent Configuration
AGENT_NAME={{AGENT_NAME}}
AGENT_PORT={{DEPLOYMENT.port | default: 8000}}

# Voice Settings
VOICE={{REALTIME_CONFIG.voice | default: "alloy"}}
# Available voices: alloy, echo, fable, onyx, nova, shimmer, ash

{% if MEMORY.type == "redis" %}
# Redis Memory Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
{% endif %}

# Logging
LOG_LEVEL=INFO

# Development
DEBUG=false
