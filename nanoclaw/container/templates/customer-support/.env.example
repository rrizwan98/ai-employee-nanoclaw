# {{COMPANY_NAME}} Customer Support Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Company configuration
COMPANY_NAME={{COMPANY_NAME}}
DOMAIN={{DOMAIN}}

# Server configuration
HOST=0.0.0.0
PORT=8000

# Session database path
SESSION_DB_PATH=./sessions.db

# Agent customization (optional)
BILLING_INSTRUCTIONS=Handle billing inquiries professionally
TECHNICAL_INSTRUCTIONS=Provide technical support and troubleshooting
GENERAL_INSTRUCTIONS=Answer general questions about products and policies
