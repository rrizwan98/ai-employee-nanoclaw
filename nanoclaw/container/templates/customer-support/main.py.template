"""
{{COMPANY_NAME}} Customer Support System
Multi-agent support with triage and specialist agents.
Generated by AI Employee using OpenAI Agents SDK
"""
import asyncio
from fastapi import FastAPI, HTTPException, WebSocket, WebSocketDisconnect
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from typing import Optional
from agents import Runner, SQLiteSession
from agents.triage import triage_agent
from config import settings

app = FastAPI(
    title="{{COMPANY_NAME}} Support",
    description="{{DOMAIN}} customer support system with multi-agent routing",
    version="1.0.0"
)

# CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


class ChatRequest(BaseModel):
    """Chat request model."""
    message: str
    session_id: str = "default"
    customer_id: Optional[str] = None


class ChatResponse(BaseModel):
    """Chat response model."""
    response: str
    session_id: str
    agent: str


@app.post("/chat", response_model=ChatResponse)
async def chat(request: ChatRequest):
    """
    Process a support message through the multi-agent system.
    """
    try:
        session = SQLiteSession(request.session_id)
        result = await Runner.run(triage_agent, request.message, session=session)

        return ChatResponse(
            response=result.final_output,
            session_id=request.session_id,
            agent=result.last_agent.name if result.last_agent else "Triage"
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.websocket("/ws/{session_id}")
async def websocket_endpoint(websocket: WebSocket, session_id: str):
    """
    WebSocket endpoint for real-time chat.
    """
    await websocket.accept()
    session = SQLiteSession(session_id)

    try:
        while True:
            message = await websocket.receive_text()
            result = await Runner.run(triage_agent, message, session=session)

            await websocket.send_json({
                "response": result.final_output,
                "agent": result.last_agent.name if result.last_agent else "Triage"
            })
    except WebSocketDisconnect:
        pass


@app.get("/health")
async def health():
    """Health check endpoint."""
    return {
        "status": "healthy",
        "company": "{{COMPANY_NAME}}",
        "domain": "{{DOMAIN}}",
        "agents": ["triage", "billing", "technical", "general"]
    }


@app.get("/")
async def root():
    """Root endpoint with system info."""
    return {
        "name": "{{COMPANY_NAME}} Support",
        "domain": "{{DOMAIN}}",
        "agents": {
            "triage": "Routes customers to specialists",
            "billing": "Handles payment and invoice issues",
            "technical": "Handles technical troubleshooting",
            "general": "Handles general inquiries"
        },
        "endpoints": {
            "chat": "POST /chat",
            "websocket": "WS /ws/{session_id}",
            "health": "GET /health"
        }
    }


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
