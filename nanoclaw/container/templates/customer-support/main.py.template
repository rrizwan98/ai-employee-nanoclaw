"""
{{COMPANY_NAME}} Customer Support System
Multi-agent support with triage and specialist agents.
Generated by AI Employee using OpenAI Agents SDK + ChatKit
"""
import asyncio
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from config import settings
from server import server

app = FastAPI(
    title="{{COMPANY_NAME}} Support",
    description="{{DOMAIN}} customer support system with multi-agent routing + ChatKit",
    version="1.0.0"
)

# CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# Mount ChatKit routes
app.include_router(server.router, prefix="/chatkit")


@app.get("/health")
async def health():
    """Health check endpoint."""
    return {
        "status": "healthy",
        "company": "{{COMPANY_NAME}}",
        "domain": "{{DOMAIN}}",
        "agents": ["triage", "billing", "technical", "general"]
    }


@app.get("/")
async def root():
    """Root endpoint with system info."""
    return {
        "name": "{{COMPANY_NAME}} Support",
        "domain": "{{DOMAIN}}",
        "agents": {
            "triage": "Routes customers to specialists",
            "billing": "Handles payment and invoice issues",
            "technical": "Handles technical troubleshooting",
            "general": "Handles general inquiries"
        },
        "endpoints": {
            "chatkit": "/chatkit/*",
            "health": "GET /health"
        }
    }


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
