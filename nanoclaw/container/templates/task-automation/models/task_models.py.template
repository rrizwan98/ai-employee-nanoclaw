"""
{{SYSTEM_NAME}} - Task Models
Pydantic models for structured task automation.
"""

from pydantic import BaseModel, Field
from typing import List, Optional, Dict, Any
from datetime import datetime
from enum import Enum


class TaskPriority(str, Enum):
    """Task priority levels."""
    LOW = "low"
    MEDIUM = "medium"
    HIGH = "high"
    CRITICAL = "critical"


class TaskStatus(str, Enum):
    """Task execution status."""
    PENDING = "pending"
    PLANNING = "planning"
    EXECUTING = "executing"
    VERIFYING = "verifying"
    COMPLETED = "completed"
    FAILED = "failed"
    CANCELLED = "cancelled"


class StepStatus(str, Enum):
    """Individual step status."""
    PENDING = "pending"
    RUNNING = "running"
    COMPLETED = "completed"
    FAILED = "failed"
    SKIPPED = "skipped"


class TaskStep(BaseModel):
    """A single executable step in a task plan."""
    step_id: str = Field(..., description="Unique identifier for the step")
    name: str = Field(..., description="Human-readable step name")
    description: str = Field(..., description="Detailed description of what the step does")
    action: str = Field(..., description="The action to perform (e.g., 'api_call', 'file_write', 'transform_data')")
    parameters: Dict[str, Any] = Field(default_factory=dict, description="Parameters for the action")
    dependencies: List[str] = Field(default_factory=list, description="List of step_ids that must complete first")
    expected_output: str = Field(..., description="Description of expected output")
    validation_rules: List[str] = Field(default_factory=list, description="Rules to validate output")
    timeout_seconds: int = Field(default=300, description="Maximum execution time")
    allow_failure: bool = Field(default=False, description="Whether task can continue if this step fails")
    rollback_action: Optional[str] = Field(default=None, description="Action to take if rollback needed")


class TaskPlan(BaseModel):
    """Complete plan for executing a task."""
    task_id: str = Field(..., description="Unique task identifier")
    description: str = Field(..., description="Overall task description")
    task_type: str = Field(..., description="Type of task (from {{TASK_TYPES}})")
    priority: TaskPriority = Field(default=TaskPriority.MEDIUM, description="Task priority")
    steps: List[TaskStep] = Field(..., description="Ordered list of steps to execute")
    success_criteria: List[str] = Field(..., description="Criteria that must be met for task success")
    estimated_duration_minutes: int = Field(..., description="Estimated total execution time")
    requires_approval: bool = Field(default=False, description="Whether human approval is needed before execution")
    metadata: Dict[str, Any] = Field(default_factory=dict, description="Additional task metadata")
    created_at: datetime = Field(default_factory=datetime.utcnow, description="Plan creation timestamp")


class ExecutionResult(BaseModel):
    """Result of executing a single step."""
    step_id: str = Field(..., description="Step identifier")
    status: StepStatus = Field(..., description="Execution status")
    output: Optional[Any] = Field(default=None, description="Step output data")
    error: Optional[str] = Field(default=None, description="Error message if failed")
    started_at: datetime = Field(default_factory=datetime.utcnow, description="Execution start time")
    completed_at: Optional[datetime] = Field(default=None, description="Execution completion time")
    retry_count: int = Field(default=0, description="Number of retries attempted")
    logs: List[str] = Field(default_factory=list, description="Execution logs")


class TaskResult(BaseModel):
    """Final verification result for a completed task."""
    task_id: str = Field(..., description="Task identifier")
    overall_status: TaskStatus = Field(..., description="Final task status")
    passed: bool = Field(..., description="Whether task passed verification")
    completion_percentage: float = Field(..., description="Percentage of steps completed successfully (0-100)")
    step_results: List[ExecutionResult] = Field(..., description="Results for each step")
    issues: List[str] = Field(default_factory=list, description="List of issues found during verification")
    recommendations: List[str] = Field(default_factory=list, description="Recommendations for improvement or fixes")
    verification_summary: str = Field(..., description="Human-readable summary of verification")
    completed_at: datetime = Field(default_factory=datetime.utcnow, description="Verification completion time")
    metadata: Dict[str, Any] = Field(default_factory=dict, description="Additional verification metadata")


class ScheduledTask(BaseModel):
    """Task scheduled for future or recurring execution."""
    schedule_id: str = Field(..., description="Unique schedule identifier")
    task_description: str = Field(..., description="Task to execute")
    cron_expression: str = Field(..., description="Cron expression for scheduling")
    enabled: bool = Field(default=True, description="Whether schedule is active")
    last_run: Optional[datetime] = Field(default=None, description="Last execution time")
    next_run: Optional[datetime] = Field(default=None, description="Next scheduled execution")
    context: Dict[str, Any] = Field(default_factory=dict, description="Execution context")
