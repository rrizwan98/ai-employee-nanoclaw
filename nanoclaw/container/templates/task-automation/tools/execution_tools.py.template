# Tool function definitions for OpenAI Agents SDK

async def api_call(
    method: str,
    url: str,
    headers: Optional[Dict[str, str]] = None,
    params: Optional[Dict[str, Any]] = None,
    body: Optional[Dict[str, Any]] = None,
    timeout: int = 30
) -> Dict[str, Any]:
    """
    Make an HTTP API call.

    Args:
        method: HTTP method (GET, POST, PUT, DELETE, PATCH)
        url: Target URL
        headers: Optional HTTP headers
        params: Optional query parameters
        body: Optional request body (for POST/PUT/PATCH)
        timeout: Request timeout in seconds

    Returns:
        Dict with status, headers, and response data
    """
    try:
        async with httpx.AsyncClient(timeout=timeout) as client:
            response = await client.request(
                method=method.upper(),
                url=url,
                headers=headers,
                params=params,
                json=body
            )

            return {
                "status_code": response.status_code,
                "headers": dict(response.headers),
                "data": response.json() if response.headers.get("content-type", "").startswith("application/json") else response.text,
                "success": response.is_success
            }
    except Exception as e:
        logger.error(f"API call failed: {e}")
        return {
            "status_code": 0,
            "error": str(e),
            "success": False
        }


async def read_file(file_path: str, encoding: str = "utf-8") -> Dict[str, Any]:
    """
    Read contents of a file.

    Args:
        file_path: Path to the file
        encoding: File encoding (default: utf-8)

    Returns:
        Dict with file content or error
    """
    try:
        path = Path(file_path)
        if not path.exists():
            return {"success": False, "error": f"File not found: {file_path}"}

        content = path.read_text(encoding=encoding)
        return {
            "success": True,
            "content": content,
            "size_bytes": path.stat().st_size,
            "path": str(path.absolute())
        }
    except Exception as e:
        logger.error(f"File read failed: {e}")
        return {"success": False, "error": str(e)}


async def write_file(
    file_path: str,
    content: str,
    encoding: str = "utf-8",
    create_dirs: bool = True
) -> Dict[str, Any]:
    """
    Write content to a file.

    Args:
        file_path: Path to the file
        content: Content to write
        encoding: File encoding (default: utf-8)
        create_dirs: Whether to create parent directories

    Returns:
        Dict with success status
    """
    try:
        path = Path(file_path)

        if create_dirs:
            path.parent.mkdir(parents=True, exist_ok=True)

        path.write_text(content, encoding=encoding)

        return {
            "success": True,
            "path": str(path.absolute()),
            "size_bytes": path.stat().st_size
        }
    except Exception as e:
        logger.error(f"File write failed: {e}")
        return {"success": False, "error": str(e)}


async def transform_data(
    input_data: Any,
    transformation: str,
    options: Optional[Dict[str, Any]] = None
) -> Dict[str, Any]:
    """
    Transform data using specified transformation.

    Args:
        input_data: Data to transform
        transformation: Transformation type (e.g., 'json_to_csv', 'filter', 'map', 'aggregate')
        options: Transformation-specific options

    Returns:
        Dict with transformed data
    """
    try:
        options = options or {}

        if transformation == "json_to_csv":
            import csv
            import io

            output = io.StringIO()
            if isinstance(input_data, list) and len(input_data) > 0:
                writer = csv.DictWriter(output, fieldnames=input_data[0].keys())
                writer.writeheader()
                writer.writerows(input_data)
                return {"success": True, "output": output.getvalue(), "format": "csv"}

        elif transformation == "filter":
            field = options.get("field")
            value = options.get("value")
            if isinstance(input_data, list):
                filtered = [item for item in input_data if item.get(field) == value]
                return {"success": True, "output": filtered, "count": len(filtered)}

        elif transformation == "map":
            field = options.get("field")
            if isinstance(input_data, list):
                mapped = [item.get(field) for item in input_data if field in item]
                return {"success": True, "output": mapped, "count": len(mapped)}

        elif transformation == "aggregate":
            field = options.get("field")
            operation = options.get("operation", "sum")  # sum, avg, min, max, count
            if isinstance(input_data, list):
                values = [item.get(field, 0) for item in input_data if field in item]
                if operation == "sum":
                    result = sum(values)
                elif operation == "avg":
                    result = sum(values) / len(values) if values else 0
                elif operation == "min":
                    result = min(values) if values else None
                elif operation == "max":
                    result = max(values) if values else None
                elif operation == "count":
                    result = len(values)
                else:
                    return {"success": False, "error": f"Unknown operation: {operation}"}

                return {"success": True, "output": result, "operation": operation}

        return {"success": False, "error": f"Unknown transformation: {transformation}"}

    except Exception as e:
        logger.error(f"Data transformation failed: {e}")
        return {"success": False, "error": str(e)}


