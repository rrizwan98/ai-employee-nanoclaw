# {{SYSTEM_NAME}} Environment Configuration

# System Configuration
SYSTEM_NAME={{SYSTEM_NAME}}
DOMAIN={{DOMAIN}}

# API Keys (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI Configuration
OPENAI_MODEL=gpt-4o-2024-08-06

# Task Execution
MAX_RETRIES={{MAX_RETRIES}}
ENABLE_SCHEDULER={{ENABLE_SCHEDULER}}

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO

# Database (Optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# File Storage
STORAGE_PATH=./storage

# Email Notifications (Optional)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password

# Slack Notifications (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Twilio SMS (Optional)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# Task Type Configuration
# Supported task types for this domain
# Examples:
# - data_processing: ETL, transformations, aggregations
# - api_orchestration: Multi-step API workflows
# - report_generation: Generate and send reports
# - file_operations: Batch file processing
# - notifications: Send alerts and notifications
