"""
ChatKit Server for {{SYSTEM_NAME}} Task Automation.
Generated by AI Employee using OpenAI Agents SDK + ChatKit
"""

from collections.abc import AsyncIterator

from chatkit.server import ChatKitServer
from chatkit.types import (
    ThreadMetadata,
    ThreadStreamEvent,
    UserMessageItem,
)
from chatkit.agents import AgentContext, simple_to_agent_input, stream_agent_response
from agents import Agent, Runner

from config import settings
from store import InMemoryStore


# Task automation chat agent for interactive mode
task_automation_chat_agent = Agent(
    name="TaskAutomationChat",
    instructions="""You are a {{DOMAIN}} task automation assistant.
Help users understand and manage automated workflows.

You can help with:
1. Explaining how the planner-executor-verifier pattern works
2. Answering questions about task scheduling and execution
3. Guiding users through creating automated workflows
4. Explaining task status and verification results

For actual task execution, users should use the /tasks endpoint directly.
Supported task types: {{TASK_TYPES}}
Max retries: {{MAX_RETRIES}}
""",
)


class TaskAutomationChatKitServer(ChatKitServer[dict]):
    """ChatKit server for interactive task automation conversations."""

    def __init__(self, store: InMemoryStore):
        super().__init__(store)

    async def respond(
        self,
        thread: ThreadMetadata,
        input_user_message: UserMessageItem | None,
        context: dict,
    ) -> AsyncIterator[ThreadStreamEvent]:
        """Generate response using task automation chat agent."""

        # Load thread history for context
        items_page = await self.store.load_thread_items(
            thread.id,
            after=None,
            limit=20,
            order="asc",
            context=context,
        )

        # Convert ChatKit thread items to agent input
        agent_input = await simple_to_agent_input(items_page.data)

        # Create agent context for streaming
        agent_context = AgentContext(
            thread=thread,
            store=self.store,
            request_context=context,
        )

        # Run agent and stream response
        result = Runner.run_streamed(task_automation_chat_agent, agent_input, context=agent_context)

        async for event in stream_agent_response(agent_context, result):
            yield event


# Initialize server with in-memory store
store = InMemoryStore()
server = TaskAutomationChatKitServer(store=store)
