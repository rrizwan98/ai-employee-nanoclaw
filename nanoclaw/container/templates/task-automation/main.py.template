# In-memory storage (replace with database in production)
task_store: Dict[str, Dict[str, Any]] = {}


# Request/Response Models
class TaskRequest(BaseModel):
    """Request to execute a task."""
    description: str
    context: Optional[Dict[str, Any]] = None
    async_execution: bool = False


class TaskStatusResponse(BaseModel):
    """Status of a task execution."""
    task_id: str
    status: TaskStatus
    plan: Optional[TaskPlan] = None
    result: Optional[TaskResult] = None
    error: Optional[str] = None
    created_at: datetime
    updated_at: datetime


class ScheduleRequest(BaseModel):
    """Request to create a scheduled task."""
    schedule_id: str
    task_description: str
    cron_expression: str
    context: Optional[Dict[str, Any]] = None
    enabled: bool = True


# Evaluation loop implementation
async def execute_task_with_evaluation(task_id: str, task_description: str, context: Optional[Dict] = None):
    """
    Execute a task using the evaluation loop pattern:
    1. Plan the task
    2. Execute steps
    3. Verify results
    4. Retry if verification fails (up to MAX_RETRIES)
    """
    task_store[task_id] = {
        "task_id": task_id,
        "status": TaskStatus.PLANNING,
        "plan": None,
        "result": None,
        "error": None,
        "created_at": datetime.utcnow(),
        "updated_at": datetime.utcnow()
    }

    max_retries = {{MAX_RETRIES}}
    retry_count = 0

    try:
        # Step 1: Plan the task
        logger.info(f"Planning task {task_id}")
        task_plan = await plan_task(task_description, context=context)

        task_store[task_id]["plan"] = task_plan
        task_store[task_id]["status"] = TaskStatus.EXECUTING
        task_store[task_id]["updated_at"] = datetime.utcnow()

        # Evaluation loop: execute and verify until success or max retries
        while retry_count <= max_retries:
            logger.info(f"Executing task {task_id} (attempt {retry_count + 1}/{max_retries + 1})")

            # Step 2: Execute all steps
            execution_results = []
            for step in task_plan.steps:
                result = await execute_step(step, context=context)
                execution_results.append(result)

                # Stop execution if a critical step fails
                if result.status == "failed" and not step.allow_failure:
                    logger.error(f"Critical step {step.step_id} failed, stopping execution")
                    break

            # Step 3: Verify execution
            task_store[task_id]["status"] = TaskStatus.VERIFYING
            task_store[task_id]["updated_at"] = datetime.utcnow()

            logger.info(f"Verifying task {task_id}")
            verification = await verify_execution(task_plan, execution_results, context=context)

            task_store[task_id]["result"] = verification
            task_store[task_id]["updated_at"] = datetime.utcnow()

            # Step 4: Check if verification passed
            if verification.passed:
                logger.info(f"Task {task_id} completed successfully")
                task_store[task_id]["status"] = TaskStatus.COMPLETED
                return
            else:
                logger.warning(f"Task {task_id} failed verification (attempt {retry_count + 1})")
                logger.warning(f"Issues: {verification.issues}")

                retry_count += 1

                if retry_count <= max_retries:
                    # Wait before retrying (exponential backoff)
                    await asyncio.sleep(2 ** retry_count)

                    # Update status for retry
                    task_store[task_id]["status"] = TaskStatus.EXECUTING
                    task_store[task_id]["updated_at"] = datetime.utcnow()

        # All retries exhausted
        logger.error(f"Task {task_id} failed after {retry_count} attempts")
        task_store[task_id]["status"] = TaskStatus.FAILED
        task_store[task_id]["error"] = f"Task failed verification after {retry_count} attempts"
        task_store[task_id]["updated_at"] = datetime.utcnow()

    except Exception as e:
        logger.error(f"Error executing task {task_id}: {e}", exc_info=True)
        task_store[task_id]["status"] = TaskStatus.FAILED
        task_store[task_id]["error"] = str(e)
        task_store[task_id]["updated_at"] = datetime.utcnow()


# API Endpoints

@app.post("/tasks", response_model=TaskStatusResponse)
async def create_task(request: TaskRequest, background_tasks: BackgroundTasks):
    """
    Create and execute a new task.

    If async_execution is True, the task will run in the background.
    Otherwise, this endpoint will wait for completion.
    """
    import uuid
    task_id = str(uuid.uuid4())

    if request.async_execution:
        # Execute in background
        background_tasks.add_task(
            execute_task_with_evaluation,
            task_id,
            request.description,
            request.context
        )

        # Return immediately with pending status
        return TaskStatusResponse(
            task_id=task_id,
            status=TaskStatus.PLANNING,
            created_at=datetime.utcnow(),
            updated_at=datetime.utcnow()
        )
    else:
        # Execute synchronously
        await execute_task_with_evaluation(task_id, request.description, request.context)

        # Return final status
        task_data = task_store[task_id]
        return TaskStatusResponse(**task_data)


@app.get("/tasks/{task_id}", response_model=TaskStatusResponse)
async def get_task_status(task_id: str):
    """Get the status of a task."""
    if task_id not in task_store:
        raise HTTPException(status_code=404, detail="Task not found")

    return TaskStatusResponse(**task_store[task_id])


@app.get("/tasks", response_model=List[TaskStatusResponse])
async def list_tasks(status: Optional[TaskStatus] = None):
    """List all tasks, optionally filtered by status."""
    tasks = list(task_store.values())

    if status:
        tasks = [t for t in tasks if t["status"] == status]

    return [TaskStatusResponse(**t) for t in tasks]


# Scheduler endpoints (if enabled)
if {{ENABLE_SCHEDULER}}:

    @app.post("/schedules", response_model=ScheduledTask)
    async def create_schedule(request: ScheduleRequest):
        """Create a new scheduled task."""
        try:
            task = scheduler.create_schedule(
                schedule_id=request.schedule_id,
                task_description=request.task_description,
                cron_expression=request.cron_expression,
                context=request.context,
                enabled=request.enabled
            )
            return task
        except ValueError as e:
            raise HTTPException(status_code=400, detail=str(e))


    @app.get("/schedules/{schedule_id}", response_model=ScheduledTask)
    async def get_schedule(schedule_id: str):
        """Get a scheduled task by ID."""
        task = scheduler.get_schedule(schedule_id)
        if not task:
            raise HTTPException(status_code=404, detail="Schedule not found")
        return task


    @app.get("/schedules", response_model=List[ScheduledTask])
    async def list_schedules(enabled_only: bool = False):
        """List all scheduled tasks."""
        return scheduler.list_schedules(enabled_only=enabled_only)


    @app.put("/schedules/{schedule_id}", response_model=ScheduledTask)
    async def update_schedule(
        schedule_id: str,
        task_description: Optional[str] = None,
        cron_expression: Optional[str] = None,
        context: Optional[Dict] = None,
        enabled: Optional[bool] = None
    ):
        """Update a scheduled task."""
        try:
            task = scheduler.update_schedule(
                schedule_id=schedule_id,
                task_description=task_description,
                cron_expression=cron_expression,
                context=context,
                enabled=enabled
            )
            return task
        except ValueError as e:
            raise HTTPException(status_code=404, detail=str(e))


    @app.delete("/schedules/{schedule_id}")
    async def delete_schedule(schedule_id: str):
        """Delete a scheduled task."""
        if not scheduler.delete_schedule(schedule_id):
            raise HTTPException(status_code=404, detail="Schedule not found")
        return {"message": "Schedule deleted"}


