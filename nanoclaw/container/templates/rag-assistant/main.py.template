"""
{{AGENT_NAME}} - RAG Assistant System
FastAPI server with document search and upload capabilities.
Domain: {{DOMAIN}}
Generated by AI Employee using OpenAI Agents SDK
"""
import asyncio
from fastapi import FastAPI, HTTPException, UploadFile, File
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from typing import Optional, List
from agents import Runner, SQLiteSession
from agents.rag_agent import rag_agent
from tools.document_tools import DocumentManager
from config import settings
import tempfile
import os


app = FastAPI(
    title="{{AGENT_NAME}}",
    description="{{DOMAIN}} RAG assistant with document search and upload",
    version="1.0.0"
)

# CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Initialize document manager
doc_manager = DocumentManager()


class ChatRequest(BaseModel):
    """Chat request model."""
    message: str
    session_id: str = "default"


class ChatResponse(BaseModel):
    """Chat response model."""
    response: str
    session_id: str
    sources: Optional[List[dict]] = None


class UploadResponse(BaseModel):
    """Upload response model."""
    success: bool
    file_id: str
    message: str


@app.post("/chat", response_model=ChatResponse)
async def chat(request: ChatRequest):
    """
    Process a message through the RAG agent.
    Searches the knowledge base and returns relevant answers.
    """
    try:
        session = SQLiteSession(request.session_id)
        result = await Runner.run(rag_agent, request.message, session=session)

        return ChatResponse(
            response=result.final_output,
            session_id=request.session_id,
            sources=None  # Sources included in response if INCLUDE_CITATIONS=True
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/upload", response_model=UploadResponse)
async def upload_document(file: UploadFile = File(...)):
    """
    Upload a document to the vector store.
    Accepts: PDF, TXT, DOCX, MD, JSON, CSV, XML
    """
    try:
        # Validate file type
        allowed_extensions = {
            '.txt', '.pdf', '.doc', '.docx',
            '.md', '.json', '.csv', '.xml'
        }
        file_ext = os.path.splitext(file.filename)[1].lower()

        if file_ext not in allowed_extensions:
            raise HTTPException(
                status_code=400,
                detail=f"Unsupported file type. Allowed: {', '.join(allowed_extensions)}"
            )

        # Save to temporary file
        with tempfile.NamedTemporaryFile(delete=False, suffix=file_ext) as tmp:
            content = await file.read()
            tmp.write(content)
            tmp_path = tmp.name

        try:
            # Upload to vector store
            file_ids = doc_manager.upload_to_vector_store(
                vector_store_id=settings.VECTOR_STORE_ID,
                file_paths=[tmp_path]
            )

            return UploadResponse(
                success=True,
                file_id=file_ids[0],
                message=f"Successfully uploaded {file.filename} to knowledge base"
            )
        finally:
            # Clean up temp file
            os.unlink(tmp_path)

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/documents")
async def list_documents():
    """
    List all documents in the vector store.
    """
    try:
        files = doc_manager.list_vector_store_files(settings.VECTOR_STORE_ID)
        return {
            "vector_store_id": settings.VECTOR_STORE_ID,
            "total_files": len(files),
            "files": files
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/vectorstore")
async def vectorstore_info():
    """
    Get information about the vector store.
    """
    try:
        info = doc_manager.get_vector_store_info(settings.VECTOR_STORE_ID)
        return info
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/health")
async def health():
    """Health check endpoint."""
    return {
        "status": "healthy",
        "agent": "{{AGENT_NAME}}",
        "domain": "{{DOMAIN}}",
        "vector_store_id": settings.VECTOR_STORE_ID,
        "max_results": settings.MAX_RESULTS,
        "include_citations": settings.INCLUDE_CITATIONS
    }


@app.get("/")
async def root():
    """Root endpoint with system info."""
    return {
        "name": "{{AGENT_NAME}}",
        "domain": "{{DOMAIN}}",
        "description": "RAG assistant with document search capabilities",
        "capabilities": {
            "search": "Search knowledge base using vector similarity",
            "upload": "Upload new documents to knowledge base",
            "chat": "Conversational interface with context",
            "citations": settings.INCLUDE_CITATIONS
        },
        "endpoints": {
            "chat": "POST /chat - Send messages to the agent",
            "upload": "POST /upload - Upload documents to knowledge base",
            "documents": "GET /documents - List all documents",
            "vectorstore": "GET /vectorstore - Vector store information",
            "health": "GET /health - Health check"
        },
        "configuration": {
            "max_results": settings.MAX_RESULTS,
            "model": settings.MODEL_NAME
        }
    }


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
