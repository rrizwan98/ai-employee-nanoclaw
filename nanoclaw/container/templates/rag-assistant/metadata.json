{
  "name": "rag-assistant",
  "displayName": "RAG Assistant",
  "description": "Document search and Q&A agent using OpenAI File Search with vector stores and ChatKit integration",
  "version": "2.0.0",
  "agents": ["rag_agent"],
  "patterns": ["rag", "file-search", "chatkit"],
  "sdkFeatures": ["FileSearchTool", "vector_stores", "sessions", "chatkit"],
  "useCases": ["knowledge base", "document search", "Q&A", "research assistant"],
  "keywords": ["rag", "knowledge", "document", "search", "vector", "file-search", "qa"],
  "complexity": "medium",
  "files": [
    {"path": "main.py", "template": "main.py.template"},
    {"path": "server.py", "template": "server.py.template"},
    {"path": "store.py", "template": "store.py.template"},
    {"path": "agents/__init__.py", "template": "agents/__init__.py.template"},
    {"path": "agents/rag_agent.py", "template": "agents/rag_agent.py.template"},
    {"path": "tools/document_tools.py", "template": "tools/document_tools.py.template"},
    {"path": "config.py", "template": "config.py.template"},
    {"path": "requirements.txt", "template": "requirements.txt"},
    {"path": ".env.example", "template": ".env.example"},
    {"path": "Dockerfile", "template": "Dockerfile"},
    {"path": "README.md", "template": "README.md.template"},
    {"path": "setup_vectorstore.py", "template": "setup_vectorstore.py.template"}
  ],
  "variables": [
    {"name": "AGENT_NAME", "description": "Name of the RAG assistant", "required": true},
    {"name": "DOMAIN", "description": "Domain or topic area of the knowledge base", "required": true},
    {"name": "VECTOR_STORE_ID", "description": "OpenAI vector store ID", "required": true},
    {"name": "MAX_RESULTS", "description": "Maximum search results to retrieve", "default": "10"},
    {"name": "INCLUDE_CITATIONS", "description": "Include source citations in responses", "default": "true"}
  ]
}
