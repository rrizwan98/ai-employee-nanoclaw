from collections.abc import AsyncIterator

from chatkit.server import ChatKitServer
from chatkit.types import (
    ThreadMetadata,
    ThreadStreamEvent,
    UserMessageItem,
)
from chatkit.agents import AgentContext, simple_to_agent_input, stream_agent_response
from agents import Agent, Runner

from config import settings
from store import InMemoryStore


# Data processor chat agent for interactive mode
data_processor_chat_agent = Agent(
    name="DataProcessorChat",
    instructions="""You are a {{DOMAIN}} data processing assistant.
Help users understand the data pipeline and process their data.

You can help with:
1. Explaining how the {{INPUT_TYPE}} to {{OUTPUT_TYPE}} pipeline works
2. Answering questions about validation rules: {{VALIDATION_RULES}}
3. Guiding users through data processing

For actual data processing, users should use the /process endpoint directly.
""",
)


class DataProcessorChatKitServer(ChatKitServer[dict]):
    """ChatKit server for interactive data processor conversations."""

    def __init__(self, store: InMemoryStore):
        super().__init__(store)

    async def respond(
        self,
        thread: ThreadMetadata,
        input_user_message: UserMessageItem | None,
        context: dict,
    ) -> AsyncIterator[ThreadStreamEvent]:
        """Generate response using data processor chat agent."""

        # Load thread history for context
        items_page = await self.store.load_thread_items(
            thread.id,
            after=None,
            limit=20,
            order="asc",
            context=context,
        )

        # Convert ChatKit thread items to agent input
        agent_input = await simple_to_agent_input(items_page.data)

        # Create agent context for streaming
        agent_context = AgentContext(
            thread=thread,
            store=self.store,
            request_context=context,
        )

        # Run agent and stream response
        result = Runner.run_streamed(data_processor_chat_agent, agent_input, context=agent_context)

        async for event in stream_agent_response(agent_context, result):
            yield event


# Initialize server with in-memory store
store = InMemoryStore()
server = DataProcessorChatKitServer(store=store)
