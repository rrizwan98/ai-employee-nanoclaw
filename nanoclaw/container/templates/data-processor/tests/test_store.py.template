import pytest
from datetime import datetime
from chatkit.types import ThreadMetadata


@pytest.mark.asyncio
async def test_save_and_load_thread(store):
    """Test thread save and load operations."""
    thread = ThreadMetadata(
        id="test-thread-1",
        title="Test Thread",
        created_at=datetime.now(),
    )

    # Save thread
    await store.save_thread(thread, context={})

    # Load thread
    loaded = await store.load_thread("test-thread-1", context={})
    assert loaded.id == "test-thread-1"
    assert loaded.title == "Test Thread"


@pytest.mark.asyncio
async def test_load_threads_pagination(store):
    """Test thread listing with pagination."""
    # Create some threads
    for i in range(5):
        thread = ThreadMetadata(
            id=f"thread-{i}",
            title=f"Thread {i}",
            created_at=datetime.now(),
        )
        await store.save_thread(thread, context={})

    # Load with pagination
    result = await store.load_threads(
        limit=3,
        after=None,
        order="desc",
        context={}
    )

    assert hasattr(result, 'data')
    assert hasattr(result, 'has_more')
    assert len(result.data) <= 3


@pytest.mark.asyncio
async def test_delete_thread(store):
    """Test thread deletion."""
    thread = ThreadMetadata(
        id="delete-test",
        title="To Delete",
        created_at=datetime.now(),
    )

    await store.save_thread(thread, context={})
    await store.delete_thread("delete-test", context={})

    # Verify deleted
    from chatkit.store import NotFoundError
    with pytest.raises(NotFoundError):
        await store.load_thread("delete-test", context={})


@pytest.mark.asyncio
async def test_thread_items(store):
    """Test thread item operations."""
    from chatkit.types import ThreadItem

    # Create thread first
    thread = ThreadMetadata(
        id="items-test",
        title="Items Test",
        created_at=datetime.now(),
    )
    await store.save_thread(thread, context={})

    # Add item
    item = ThreadItem(
        id="item-1",
        thread_id="items-test",
        created_at=datetime.now(),
    )
    await store.add_thread_item("items-test", item, context={})

    # Load items
    result = await store.load_thread_items(
        thread_id="items-test",
        after=None,
        limit=10,
        order="asc",
        context={}
    )

    assert len(result.data) == 1
    assert result.data[0].id == "item-1"
