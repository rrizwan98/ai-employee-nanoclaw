"""
{{SYSTEM_NAME}} Multi-Agent System
Orchestrator with specialist agents using agent-as-tool pattern.
Generated by AI Employee using OpenAI Agents SDK
"""
import asyncio
from fastapi import FastAPI, HTTPException, WebSocket, WebSocketDisconnect
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from typing import Optional, List
from agents import Runner, SQLiteSession
from agents.orchestrator import orchestrator_agent
from context.shared_context import shared_context
from config import settings

app = FastAPI(
    title="{{SYSTEM_NAME}}",
    description="Multi-agent system for {{DOMAIN}} with orchestrator and specialist agents",
    version="1.0.0"
)

# CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


class ChatRequest(BaseModel):
    """Chat request model."""
    message: str
    session_id: str = "default"
    user_id: Optional[str] = None
    metadata: Optional[dict] = None


class ChatResponse(BaseModel):
    """Chat response model."""
    response: str
    session_id: str
    agent: str
    tasks_created: Optional[List[dict]] = None


class SystemStatus(BaseModel):
    """System status model."""
    status: str
    system_name: str
    domain: str
    orchestrator: str
    specialists: List[str]
    active_sessions: int
    total_tasks: int


@app.post("/chat", response_model=ChatResponse)
async def chat(request: ChatRequest):
    """
    Process a message through the multi-agent system.

    The orchestrator will analyze the request and delegate to appropriate specialists.
    """
    try:
        # Log conversation start
        shared_context.add_conversation("user", request.message, "system")

        # Run through orchestrator
        session = SQLiteSession(request.session_id)
        result = await Runner.run(
            orchestrator_agent,
            request.message,
            session=session,
            context=shared_context
        )

        # Log response
        shared_context.add_conversation(
            "assistant",
            result.final_output,
            result.last_agent.name if result.last_agent else orchestrator_agent.name
        )

        # Get tasks created during this interaction
        tasks = shared_context.get("tasks", [])

        return ChatResponse(
            response=result.final_output,
            session_id=request.session_id,
            agent=result.last_agent.name if result.last_agent else orchestrator_agent.name,
            tasks_created=tasks
        )
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.websocket("/ws/{session_id}")
async def websocket_endpoint(websocket: WebSocket, session_id: str):
    """
    WebSocket endpoint for real-time chat.
    """
    await websocket.accept()
    session = SQLiteSession(session_id)

    try:
        while True:
            message = await websocket.receive_text()

            # Log conversation
            shared_context.add_conversation("user", message, "system")

            # Process through orchestrator
            result = await Runner.run(
                orchestrator_agent,
                message,
                session=session,
                context=shared_context
            )

            # Log response
            shared_context.add_conversation(
                "assistant",
                result.final_output,
                result.last_agent.name if result.last_agent else orchestrator_agent.name
            )

            # Send response
            await websocket.send_json({
                "response": result.final_output,
                "agent": result.last_agent.name if result.last_agent else orchestrator_agent.name,
                "timestamp": shared_context.get("conversations", [])[-1]["timestamp"]
            })
    except WebSocketDisconnect:
        pass


@app.get("/status", response_model=SystemStatus)
async def get_status():
    """
    Get system status and statistics.
    """
    tasks = shared_context.get("tasks", [])
    conversations = shared_context.get("conversations", [])

    return SystemStatus(
        status="healthy",
        system_name="{{SYSTEM_NAME}}",
        domain="{{DOMAIN}}",
        orchestrator="{{ORCHESTRATOR_NAME}}",
        specialists=[{{#each SPECIALIST_NAMES}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}],
        active_sessions=len(set(c.get("session_id", "default") for c in conversations)),
        total_tasks=len(tasks)
    )


@app.get("/tasks")
async def get_tasks(status: Optional[str] = None):
    """
    Get all tasks, optionally filtered by status.
    """
    tasks = shared_context.get("tasks", [])

    if status:
        tasks = [t for t in tasks if t.get("status") == status]

    return {"tasks": tasks}


@app.get("/activity")
async def get_activity(limit: int = 50):
    """
    Get recent activity log.
    """
    log = shared_context.get_activity_log(min(limit, 100))
    return {"activity": log}


@app.get("/health")
async def health():
    """Health check endpoint."""
    return {
        "status": "healthy",
        "system": "{{SYSTEM_NAME}}",
        "domain": "{{DOMAIN}}",
    }


@app.get("/")
async def root():
    """Root endpoint with system info."""
    return {
        "name": "{{SYSTEM_NAME}}",
        "domain": "{{DOMAIN}}",
        "orchestrator": {
            "name": "{{ORCHESTRATOR_NAME}}",
            "role": "Central coordinator that delegates to specialists"
        },
        "specialists": [
{{#each SPECIALIST_NAMES}}
            {
                "name": "{{this}}_agent",
                "description": "Specialist for {{this}} tasks"
            }{{#unless @last}},{{/unless}}
{{/each}}
        ],
        "endpoints": {
            "chat": "POST /chat",
            "websocket": "WS /ws/{session_id}",
            "status": "GET /status",
            "tasks": "GET /tasks?status=<optional>",
            "activity": "GET /activity?limit=<optional>",
            "health": "GET /health"
        },
        "architecture": "Agent-as-tool pattern with shared context"
    }


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
