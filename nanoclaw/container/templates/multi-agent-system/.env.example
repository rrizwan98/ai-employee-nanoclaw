# {{SYSTEM_NAME}} Environment Configuration

# System Configuration
SYSTEM_NAME={{SYSTEM_NAME}}
DOMAIN={{DOMAIN}}
ORCHESTRATOR_NAME={{ORCHESTRATOR_NAME}}

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Session Configuration
SESSION_DB_PATH=./sessions.db

# Specialist Agent Instructions
# Customize these to define the behavior of each specialist
{{#each SPECIALIST_NAMES}}
{{upper this}}_INSTRUCTIONS="Specialist agent for {{this}} tasks in the {{../DOMAIN}} domain."
{{/each}}

# Context Configuration
MAX_CONTEXT_HISTORY=100
MAX_TASK_HISTORY=1000
MAX_ACTIVITY_LOG=500

# Logging Configuration
LOG_LEVEL=INFO

# Performance Configuration
AGENT_TIMEOUT=300
MAX_CONCURRENT_SESSIONS=100
