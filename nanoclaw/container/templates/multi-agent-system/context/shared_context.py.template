"""
{{SYSTEM_NAME}} Shared Context
Thread-safe shared state management for multi-agent coordination.
Uses RunContextWrapper for safe concurrent access.
"""
from agents import RunContextWrapper
from typing import Any, Dict, Optional
from datetime import datetime
import json


class SharedContext:
    """
    Shared context manager for coordinating state across agents.

    Features:
    - Thread-safe access using RunContextWrapper
    - Persistent state across agent calls
    - Activity logging
    - Data validation
    """

    def __init__(self):
        self.data: Dict[str, Any] = {
            "system_name": "{{SYSTEM_NAME}}",
            "domain": "{{DOMAIN}}",
            "session_started": datetime.utcnow().isoformat(),
            "conversations": [],
            "tasks": [],
            "metadata": {},
        }
        self.activity_log = []

    def get(self, key: str, default: Any = None) -> Any:
        """
        Get a value from shared context.

        Args:
            key: The key to retrieve
            default: Default value if key doesn't exist

        Returns:
            The value or default
        """
        return self.data.get(key, default)

    def set(self, key: str, value: Any) -> None:
        """
        Set a value in shared context.

        Args:
            key: The key to set
            value: The value to store
        """
        self.data[key] = value
        self.log_activity(f"Set context: {key}", {"key": key})

    def update(self, updates: Dict[str, Any]) -> None:
        """
        Update multiple values in shared context.

        Args:
            updates: Dictionary of key-value pairs to update
        """
        self.data.update(updates)
        self.log_activity("Bulk update", {"keys": list(updates.keys())})

    def add_conversation(self, role: str, message: str, agent: str) -> None:
        """
        Add a conversation turn to history.

        Args:
            role: user or assistant
            message: The message content
            agent: The agent handling this turn
        """
        self.data["conversations"].append({
            "timestamp": datetime.utcnow().isoformat(),
            "role": role,
            "message": message,
            "agent": agent,
        })

    def add_task(self, task_name: str, assigned_to: str, status: str = "pending") -> str:
        """
        Add a task to track.

        Args:
            task_name: Name of the task
            assigned_to: Agent assigned to the task
            status: Task status (pending, in_progress, completed, failed)

        Returns:
            Task ID
        """
        task_id = f"task_{len(self.data['tasks']) + 1}"
        task = {
            "id": task_id,
            "name": task_name,
            "assigned_to": assigned_to,
            "status": status,
            "created_at": datetime.utcnow().isoformat(),
            "updated_at": datetime.utcnow().isoformat(),
        }
        self.data["tasks"].append(task)
        self.log_activity(f"Task created: {task_name}", {"task_id": task_id})
        return task_id

    def update_task(self, task_id: str, status: str, result: Optional[str] = None) -> None:
        """
        Update task status.

        Args:
            task_id: The task ID
            status: New status
            result: Optional result description
        """
        for task in self.data["tasks"]:
            if task["id"] == task_id:
                task["status"] = status
                task["updated_at"] = datetime.utcnow().isoformat()
                if result:
                    task["result"] = result
                self.log_activity(f"Task updated: {task_id}", {"status": status})
                break

    def log_activity(self, action: str, details: Optional[Dict] = None) -> None:
        """
        Log an activity in the system.

        Args:
            action: Description of the action
            details: Optional additional details
        """
        entry = {
            "timestamp": datetime.utcnow().isoformat(),
            "action": action,
            "details": details or {},
        }
        self.activity_log.append(entry)

    def get_activity_log(self, limit: int = 50) -> list:
        """
        Get recent activity log entries.

        Args:
            limit: Maximum number of entries to return

        Returns:
            List of activity log entries
        """
        return self.activity_log[-limit:]

    def export_state(self) -> str:
        """
        Export the full state as JSON.

        Returns:
            JSON string of the state
        """
        return json.dumps({
            "data": self.data,
            "activity_log": self.activity_log,
        }, indent=2)

    def clear(self) -> None:
        """
        Clear all state (use with caution).
        """
        self.__init__()
        self.log_activity("State cleared", {})


# Create global shared context wrapped for safe access
_context = SharedContext()
shared_context = RunContextWrapper(_context)


# Export the wrapped context
__all__ = ["shared_context", "SharedContext"]
