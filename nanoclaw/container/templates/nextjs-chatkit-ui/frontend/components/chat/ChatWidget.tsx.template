'use client';

import { useState } from 'react';
import { ChatKit, useChatKit } from '@openai/chatkit-react';

interface ChatWidgetProps {
  apiUrl?: string;
  domainKey?: string;
  greeting?: string;
  placeholder?: string;
  colorScheme?: 'light' | 'dark';
  primaryColor?: string;
}

export default function ChatWidget({
  apiUrl = '{{backend_url}}',
  domainKey = '{{domain_key}}',
  greeting = '{{chat_greeting}}',
  placeholder = '{{chat_placeholder}}',
  colorScheme = '{{color_scheme}}' as 'light' | 'dark',
  primaryColor = '{{primary_color}}',
}: ChatWidgetProps) {
  const [isOpen, setIsOpen] = useState(false);

  const { control } = useChatKit({
    api: {
      url: apiUrl,
      domainKey: domainKey,
    },
    theme: {
      colorScheme: colorScheme,
      color: {
        accent: { primary: primaryColor, level: 1 },
      },
      radius: 'round',
    },
    startScreen: {
      greeting: greeting,
      prompts: [
        { label: 'Get Started', prompt: 'How can I get started?', icon: 'lightbulb' },
        { label: 'Pricing', prompt: 'What are your pricing plans?', icon: 'chart' },
        { label: 'Support', prompt: 'I need help with something', icon: 'write' },
      ],
    },
    composer: {
      placeholder: placeholder,
    },
    onError: ({ error }) => {
      console.error('ChatKit error:', error);
    },
  });

  return (
    <>
      {/* Chat Button - Bottom Right */}
      <button
        onClick={() => setIsOpen(!isOpen)}
        className="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-primary-600 text-white shadow-lg transition-all duration-200 hover:scale-105 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
        aria-label={isOpen ? 'Close chat' : 'Open chat'}
      >
        {isOpen ? (
          <svg className="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
          </svg>
        ) : (
          <svg className="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeWidth={2}
              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            />
          </svg>
        )}
      </button>

      {/* Chat Panel */}
      {isOpen && (
        <div className="fixed bottom-24 right-6 z-40 h-[600px] w-[380px] overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-gray-700 dark:bg-gray-900 animate-in slide-in-from-bottom-4 duration-200 max-sm:inset-4 max-sm:bottom-20 max-sm:right-4 max-sm:h-auto max-sm:w-auto">
          <ChatKit control={control} className="h-full w-full" />
        </div>
      )}
    </>
  );
}
