# Agent Builder AI Employee - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# ASSISTANT CONFIGURATION
# ===========================================
ASSISTANT_NAME=AgentBuilder

# ===========================================
# ANTHROPIC API (Required)
# ===========================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ===========================================
# CONTAINER SETTINGS
# ===========================================
CONTAINER_IMAGE=nanoclaw-agent:latest
CONTAINER_TIMEOUT=300000

# ===========================================
# DATABASE (Neon PostgreSQL)
# ===========================================
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require

# ===========================================
# WHATSAPP
# ===========================================
WHATSAPP_PHONE=03492128287

# ===========================================
# TIMEZONE
# ===========================================
TZ=Asia/Karachi

# ===========================================
# GITHUB MCP SERVER (Optional - for GitHub delivery)
# ===========================================
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
# This enables: repository creation, code push, PR creation
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here
