{
  "name": "nextjs-chatkit-ui",
  "displayName": "Next.js ChatKit UI",
  "description": "Next.js 14+ frontend with OpenAI ChatKit chat widget integration. Creates responsive websites with AI chat support.",
  "version": "1.0.0",
  "agents": ["frontend"],
  "patterns": ["frontend", "chatkit", "nextjs"],
  "sdkFeatures": ["chatkit-react", "streaming"],
  "useCases": ["website with chat", "landing page", "SaaS frontend", "restaurant website", "clinic website", "portfolio"],
  "keywords": ["website", "frontend", "nextjs", "chatkit", "ui", "landing", "chat", "web app", "landing page", "react", "tailwind"],
  "complexity": "medium",
  "files": [
    {"path": "frontend/components/ui/Button.tsx", "template": "frontend/components/ui/Button.tsx.template"},
    {"path": "frontend/components/ui/Card.tsx", "template": "frontend/components/ui/Card.tsx.template"},
    {"path": "frontend/components/ui/Input.tsx", "template": "frontend/components/ui/Input.tsx.template"},
    {"path": "frontend/components/ui/Badge.tsx", "template": "frontend/components/ui/Badge.tsx.template"},
    {"path": "frontend/components/layout/Header.tsx", "template": "frontend/components/layout/Header.tsx.template"},
    {"path": "frontend/components/layout/Footer.tsx", "template": "frontend/components/layout/Footer.tsx.template"},
    {"path": "frontend/components/sections/Hero.tsx", "template": "frontend/components/sections/Hero.tsx.template"},
    {"path": "frontend/components/sections/Features.tsx", "template": "frontend/components/sections/Features.tsx.template"},
    {"path": "frontend/components/sections/Pricing.tsx", "template": "frontend/components/sections/Pricing.tsx.template"},
    {"path": "frontend/components/sections/Testimonials.tsx", "template": "frontend/components/sections/Testimonials.tsx.template"},
    {"path": "frontend/components/sections/CTA.tsx", "template": "frontend/components/sections/CTA.tsx.template"},
    {"path": "frontend/components/sections/FAQ.tsx", "template": "frontend/components/sections/FAQ.tsx.template"},
    {"path": "frontend/components/sections/ContactSection.tsx", "template": "frontend/components/sections/ContactSection.tsx.template"},
    {"path": "frontend/components/forms/ContactForm.tsx", "template": "frontend/components/forms/ContactForm.tsx.template"},
    {"path": "frontend/components/forms/BookingForm.tsx", "template": "frontend/components/forms/BookingForm.tsx.template"},
    {"path": "frontend/components/chat/ChatWidget.tsx", "template": "frontend/components/chat/ChatWidget.tsx.template"},
    {"path": "frontend/components/chat/ChatProvider.tsx", "template": "frontend/components/chat/ChatProvider.tsx.template"},
    {"path": "frontend/app/layout.tsx", "template": "frontend/app/layout.tsx.template"},
    {"path": "frontend/app/page.tsx", "template": "frontend/app/page.tsx.template"},
    {"path": "frontend/app/globals.css", "template": "frontend/app/globals.css.template"},
    {"path": "frontend/app/about/page.tsx", "template": "frontend/app/about/page.tsx.template"},
    {"path": "frontend/app/contact/page.tsx", "template": "frontend/app/contact/page.tsx.template"},
    {"path": "frontend/package.json", "template": "frontend/package.json.template"},
    {"path": "frontend/tailwind.config.ts", "template": "frontend/tailwind.config.ts.template"},
    {"path": "frontend/next.config.js", "template": "frontend/next.config.js.template"},
    {"path": "frontend/tsconfig.json", "template": "frontend/tsconfig.json.template"},
    {"path": "frontend/postcss.config.js", "template": "frontend/postcss.config.js.template"},
    {"path": "frontend/lib/utils.ts", "template": "frontend/lib/utils.ts.template"},
    {"path": "frontend/lib/constants.ts", "template": "frontend/lib/constants.ts.template"},
    {"path": "frontend/.env.local.example", "template": "frontend/.env.local.example"},
    {"path": "README.md", "template": "README.md.template"}
  ],
  "variables": [
    {"name": "PROJECT_NAME", "description": "Project name (lowercase, no spaces)", "required": true},
    {"name": "PROJECT_TITLE", "description": "Display title for the website", "required": true},
    {"name": "COMPANY_NAME", "description": "Company or brand name", "required": true},
    {"name": "DESCRIPTION", "description": "Website meta description", "default": "A modern web application"},
    {"name": "PRIMARY_COLOR", "description": "Primary brand color (hex)", "default": "#6366F1"},
    {"name": "BACKEND_URL", "description": "ChatKit backend API URL", "default": "http://localhost:8000/chatkit"},
    {"name": "DOMAIN_KEY", "description": "ChatKit domain key", "default": "local-dev"},
    {"name": "CHAT_GREETING", "description": "Chat widget greeting message", "default": "Hi! How can I help you today?"},
    {"name": "HERO_TITLE", "description": "Hero section main title", "default": "Build Something Amazing"},
    {"name": "HERO_SUBTITLE", "description": "Hero section subtitle", "default": "The modern solution for your business"},
    {"name": "HERO_CTA_TEXT", "description": "Hero primary CTA button text", "default": "Get Started"},
    {"name": "CONTACT_EMAIL", "description": "Contact email address", "default": "hello@example.com"},
    {"name": "CONTACT_PHONE", "description": "Contact phone number", "default": "+1 (555) 000-0000"}
  ]
}
