'use client'

import { ReactNode } from 'react'

interface ChatProviderProps {
  children: ReactNode
  enabled?: boolean
}

/**
 * ChatProvider - Simple wrapper component
 *
 * NOTE: ChatKit is loaded via CDN in layout.tsx, NOT via npm package.
 * This provider just wraps children - ChatWidget handles all ChatKit logic.
 */
export default function ChatProvider({
  children,
  enabled = true,
}: ChatProviderProps) {
  return (
    <>
      {children}
    </>
  )
}
